<resources>

    <style name="AppTheme" parent="Theme.AppCompat">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlNormal">@color/parchmentMuted</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:textColorPrimary">@color/parchment</item>
        <item name="android:textColorSecondary">@color/parchmentMuted</item>
        <item name="android:textColorHint">@color/parchmentMuted</item>
        <item name="buttonStyle">@style/AdventureButton</item>
        <item name="android:buttonStyle">@style/AdventureButton</item>
        <item name="alertDialogTheme">@style/AdventureDialog</item>
        <item name="android:alertDialogTheme">@style/AdventureDialog</item>
        <item name="android:dialogTheme">@style/AdventureDialog</item>
    </style>

    <style name="AdventureDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/amber</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/parchment</item>
        <item name="android:textColorSecondary">@color/parchmentMuted</item>
    </style>

    <style name="AdventureButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/btn_adventure</item>
        <item name="android:textColor">@color/parchment</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">19sp</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:drawableTint">@color/amber</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Secondary menu row: icon on the left, text left-aligned. -->
    <style name="AdventureButton.Row">
        <item name="android:gravity">start|center_vertical</item>
    </style>

    <style name="AdventureButton.Primary">
        <item name="android:background">@drawable/btn_adventure_primary</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:drawableTint">@color/ink</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StoryText">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/parchment</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="SectionLabel">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/amber</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>

</resources>
